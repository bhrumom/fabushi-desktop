{
  "name": "@fabushi/desktop",
  "version": "2.0.0-alpha.1",
  "description": "Fabushi desktop - Grok Bot 0.18 parity refactor",
  "homepage": "https://github.com/bhrumom/fabushi-desktop",
  "author": "bhrumom",
  "private": true,
  "type": "module",
  "main": "electron/bootstrap.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "package:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "start": "electron ."
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.2",
    "vite": "6.4.3"
  },
  "build": {
    "appId": "com.ombhrum.fabushi",
    "productName": "Fabushi",
    "executableName": "fabushi",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/bootstrap.cjs",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/grok-agent-runtime.cjs",
      "electron/grok-agent-coordinator.cjs",
      "electron/grok-host-runtime.cjs",
      "electron/grok-mcp-manager.cjs",
      "electron/local-tool-executor.cjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "fabushi-grok-parity-${version}-macos-${arch}.${ext}"
    },
    "copyright": "Copyright © 2026 Fabushi."
  }
}
