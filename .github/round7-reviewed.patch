+                    .is_some_and(|rows| rows.iter().any(|row| row["id"].as_str() == Some(entry_id.as_str())));
+            if matches {
+                captured.lock().expect("capture target mutation").push(serde_json::Value::Object(mutation.clone()));
+            }
+        },
+    );
+    (events, subscription)
+}
