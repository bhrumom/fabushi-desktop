+impl Drop for FailureReadinessFixture {
+    fn drop(&mut self) {
+        if let Some(owners) = self.owners.take() {
+            owners.dispose(&self.agent_id);
+            owners.deps.session_workers.shutdown();
+        }
+        let _ = fs::remove_dir_all(&self.root);
+    }
+}
