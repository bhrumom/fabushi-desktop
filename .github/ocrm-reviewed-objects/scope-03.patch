+        drop(owner);
+        fixture.settings().set_host_settings(&json!({"webauthnProxyEnabled":false})).unwrap();
+        assert_eq!(fixture.readiness_calls.load(Ordering::SeqCst), 1);
+        assert_eq!(fixture.followups.lock().unwrap().len(), 1);
+    }
