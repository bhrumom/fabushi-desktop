{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": 1,
  "title": "OCRM per-responsibility parity ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "upstream",
    "inventory_authority",
    "file_coverage",
    "responsibilities",
    "completion_flags"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "const": "OCRM-001"
    },
    "upstream": {
      "type": "object",
      "required": [
        "repository",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "const": "openclaw/openclaw"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "inventory_authority": {
      "type": "object",
      "required": [
        "manifest_source",
        "prior_subject_commit",
        "prior_artifact_id",
        "prior_artifact_digest",
        "prior_raw_inventory_sha256"
      ],
      "properties": {
        "manifest_source": {
          "const": "GitHub Actions immutable artifact candidate"
        },
        "prior_subject_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "prior_artifact_id": {
          "type": "integer",
          "minimum": 1
        },
        "prior_artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "prior_raw_inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "file_coverage": {
      "type": "object",
      "required": [
        "tracked_paths",
        "unclassified_paths",
        "mapped_paths",
        "omitted_known"
      ],
      "properties": {
        "tracked_paths": {
          "type": "integer",
          "minimum": 0
        },
        "unclassified_paths": {
          "type": "integer",
          "minimum": 0
        },
        "mapped_paths": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_known": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unit_id",
          "responsibility_kind",
          "source_refs",
          "behavior",
          "preconditions",
          "postconditions",
          "invariants",
          "capability_ids",
          "requirement_ids",
          "oracle_ids",
          "existing_owner_candidates",
          "selected_owner",
          "owner_decision",
          "target",
          "typed_contracts",
          "dependencies",
          "integration",
          "required_evidence_dimensions",
          "required_gate_ids",
          "tests",
          "adr_refs",
          "migration_rollback",
          "risk",
          "blocker_ids",
          "status",
          "evidence_refs",
          "reviewer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OCRM-RESP-[A-Za-z0-9._-]+$"
          },
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "responsibility_kind": {
            "enum": [
              "business-runtime",
              "presentation",
              "platform-bridge",
              "schema-generated",
              "build-release-operations",
              "test-oracle",
              "documentation-governance",
              "asset-license",
              "non-product-disposition"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "blob_sha",
                "symbol",
                "range"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "blob_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "symbol": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "range": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            }
          },
          "behavior": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "postconditions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "capability_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "oracle_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "existing_owner_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "reason"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "selected_owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner_decision": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": "object",
            "required": [
              "path",
              "symbol",
              "language"
            ],
            "properties": {
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "typed_contracts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "integration": {
            "type": "object",
            "required": [
              "producer",
              "entrypoint",
              "owner",
              "consumer"
            ],
            "properties": {
              "producer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "entrypoint": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "owner": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "consumer": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "required_evidence_dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "required_gate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "adr_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "migration_rollback": {
            "type": [
              "string",
              "null"
            ]
          },
          "risk": {
            "type": [
              "string",
              "null"
            ]
          },
          "blocker_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "status": {
            "type": "object",
            "properties": {
              "read": {
                "enum": [
                  "unread",
                  "partial",
                  "read-complete"
                ]
              },
              "mapping": {
                "enum": [
                  "unclassified",
                  "mapped",
                  "reviewed"
                ]
              },
              "implementation": {
                "enum": [
                  "not-started",
                  "implementing",
                  "implemented"
                ]
              },
              "wiring": {
                "enum": [
                  "not-wired",
                  "wired"
                ]
              },
              "verification": {
                "enum": [
                  "not-run",
                  "failed",
                  "blocked",
                  "verified"
                ]
              },
              "acceptance": {
                "enum": [
                  "pending",
                  "rejected",
                  "accepted"
                ]
              }
            },
            "required": [
              "read",
              "mapping",
              "implementation",
              "wiring",
              "verification",
              "acceptance"
            ],
            "additionalProperties": false
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "completion_flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline_identity_accepted": {
          "type": "boolean"
        },
        "source_closure_ready": {
          "type": "boolean"
        },
        "responsibility_mapping_complete": {
          "type": "boolean"
        },
        "rust_implementation_complete": {
          "type": "boolean"
        },
        "production_wiring_complete": {
          "type": "boolean"
        },
        "ecosystem_compatibility_accepted": {
          "type": "boolean"
        },
        "ui_accepted": {
          "type": "boolean"
        },
        "release_accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "baseline_identity_accepted",
        "source_closure_ready",
        "responsibility_mapping_complete",
        "rust_implementation_complete",
        "production_wiring_complete",
        "ecosystem_compatibility_accepted",
        "ui_accepted",
        "release_accepted"
      ]
    }
  }
}
