{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": 1,
  "title": "OCRM bidirectional requirements and acceptance RTM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "upstream",
    "rows",
    "completion_flags"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "const": "OCRM-001"
    },
    "upstream": {
      "type": "object",
      "required": [
        "repository",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "const": "openclaw/openclaw"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "requirement_text_source",
          "responsibility_ids",
          "oracle_ids",
          "gate_ids",
          "evidence_refs",
          "acceptance_status",
          "blocker_ids",
          "reviewer",
          "not_applicable_reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OCRM-(R|AC)[0-9]{2}$"
          },
          "kind": {
            "enum": [
              "requirement",
              "acceptance-criterion"
            ]
          },
          "requirement_text_source": {
            "type": "string",
            "minLength": 1
          },
          "responsibility_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "oracle_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "gate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "acceptance_status": {
            "enum": [
              "not-started",
              "mapped",
              "in-progress",
              "blocked",
              "verified",
              "accepted",
              "not-applicable"
            ]
          },
          "blocker_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "not_applicable_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "completion_flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline_identity_accepted": {
          "type": "boolean"
        },
        "source_closure_ready": {
          "type": "boolean"
        },
        "responsibility_mapping_complete": {
          "type": "boolean"
        },
        "rust_implementation_complete": {
          "type": "boolean"
        },
        "production_wiring_complete": {
          "type": "boolean"
        },
        "ecosystem_compatibility_accepted": {
          "type": "boolean"
        },
        "ui_accepted": {
          "type": "boolean"
        },
        "release_accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "baseline_identity_accepted",
        "source_closure_ready",
        "responsibility_mapping_complete",
        "rust_implementation_complete",
        "production_wiring_complete",
        "ecosystem_compatibility_accepted",
        "ui_accepted",
        "release_accepted"
      ]
    }
  }
}
