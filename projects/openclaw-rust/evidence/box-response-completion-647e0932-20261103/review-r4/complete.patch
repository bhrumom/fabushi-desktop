+        Ok(vec![data(1, "third"), close(1)]),
+    ]);
+    assert_eq!(
+        manager.create_exec_instance(&(), |id| id).expect("completed stream"),
+        vec!["first", "second"],
+    );
+    assert_eq!(
+        manager.create_exec_instance(&(), |id| id).expect("nonzero identity"),
+        vec!["third"],
+    );
