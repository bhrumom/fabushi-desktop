+        Ok(Vec::new())
+    }
+
+    fn call_tool(
+        &self,
+        _tool: &RoutedToolDefinition,
+        _args: serde_json::Value,
+        _tool_call_id: &str,
+    ) -> Result<serde_json::Value, ProviderSessionError> {
+        panic!("the real Box Shell route must not dispatch an upstream fallback")
+    }
