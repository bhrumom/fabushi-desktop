+    let started = Instant::now();
+    let mut sent_term = false;
+    let mut sent_kill = false;
+    loop {
+        {
+            let mut state = owner.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+            match state.poll() {
+                Ok(Some(_)) => {
+                    state.cleanup_unknown = false;
+                    return Ok(());
+                }
+                Ok(None) => {}
+                Err(error) => {
+                    state.cleanup_unknown = true;
+                    return Err(error);
+                }
+            }
