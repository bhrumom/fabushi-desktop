+            )]);
+            assert_eq!(reports.lock().unwrap().as_slice(), &[SkillPublishEdgeFailure {
+                stage: "cleanup", error_class: classify_error(&cleanup_error.to_string()),
+            }]);
+            assert_exclusive_available(&sand_root);
+        }
+    }
