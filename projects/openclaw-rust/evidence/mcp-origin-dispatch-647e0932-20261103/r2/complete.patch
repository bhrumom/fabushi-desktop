+            "origin":successor_origin,"args":{"value":"current"},"toolCallId":"fresh-origin","agentId":"origin-agent",
+        }));
+        assert_eq!(a.relay.pending_count(), 0);
+        assert_eq!(b.relay.pending_count(), 0);
+        drop(requests);
+        drop(a_listener);
+        drop(b_listener);
+        drop(a);
+        drop(b);
+        fixture.close();
+    }
