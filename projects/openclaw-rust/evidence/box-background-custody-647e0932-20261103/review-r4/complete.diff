+            match worker.take().expect("finished background reader").join() {
+                Ok(Ok(())) => {}
+                Ok(Err(error)) => { state.failure.get_or_insert(error.phase); }
+                Err(_) => { state.failure.get_or_insert("background capture worker lost"); }
