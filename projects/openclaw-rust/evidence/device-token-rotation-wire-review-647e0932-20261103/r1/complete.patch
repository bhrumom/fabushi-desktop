+    f.stale(&node, 401); // An old allocation's proof cannot cross owner reopen.
+    f.current(&f.authenticate(&replacement));
+    f.current(&f.proof(CALLER, "node"));
+    f.token_absent(&before.token(CALLER, "operator"));
+}
