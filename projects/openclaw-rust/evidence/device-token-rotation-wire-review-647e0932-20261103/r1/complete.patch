+fn wire_rotation_pairing_self_delivers_committed_successor_and_survives_reopen() {
+    let mut f = Fixture::seeded("self", &["operator", "node"], &["operator.pairing", "node.invoke"]);
+    let proof = f.proof(CALLER, "operator");
