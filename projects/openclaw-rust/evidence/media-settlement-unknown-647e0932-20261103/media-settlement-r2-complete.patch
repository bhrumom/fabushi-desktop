+    fn message(&self, channel: bool) -> Value {
+        let mut message = json!({"type":"attachment", "url":self.resolved.url,
+            "file_name":self.resolved.file_name, "alt":"retained MSU attachment"});
+        if channel { message["channel"] = json!(ADDRESS); }
+        message
+    }
