+fn isolated(
+    name: &str,
+    provider_flow: bool,
+    product_mode: bool,
+    body: impl FnOnce(),
+) -> Vec<ProviderRequest> {
+    let exact = format!("{CASE_PREFIX}{name}");
+    if let Some(selected) = std::env::var_os(CHILD_CASE) {
+        assert_eq!(selected.to_str(), Some(exact.as_str()));
+        let owned = root();
+        let nonce = std::env::var(CHILD_NONCE).unwrap();
+        let allocation: Value = serde_json::from_slice(&fs::read(owned.join("allocation.json")).unwrap()).unwrap();
+        assert_eq!(allocation["case"], exact);
+        assert_eq!(allocation["nonce"], nonce);
+        assert_eq!(std::env::var_os("CODEX_HOME"), Some(owned.join("codex").into_os_string()));
+        assert_eq!(std::env::var_os(FABUSHI_HOST_ACCESS_CREDENTIAL_FILE_ENV),
+            Some(owned.join("native-credential.json").into_os_string()));
+        body();
+        write_private(&owned.join("completed.json"), json!({
+            "case":exact, "nonce":nonce, "pid":std::process::id(), "phase":"assertions-returned",
+        }).to_string().as_bytes());
+        return Vec::new();
+    }
+    let base = std::env::var_os("FABUSHI_AUTOMATION_CONTRACT_ARTIFACT_ROOT")
+        .map(PathBuf::from).unwrap_or_else(std::env::temp_dir);
+    fs::create_dir_all(&base).unwrap();
+    let owned = base.join(format!("rmd-app-{}-{}", std::process::id(), uuid::Uuid::new_v4()));
+    private_directory(&owned);
+    let owned = fs::canonicalize(owned).unwrap();
+    private_directory(&owned.join("codex"));
+    private_directory(&owned.join("tmp"));
+    let mut network = NetworkGuard::new(provider_flow);
+    let origin = format!("http://{}", network.address);
+    write_private(&owned.join("native-credential.json"), json!({
+        "version":1, "issuer":origin, "accessToken":PROVIDER_TOKEN,
+        "expiresAtMs":4_102_444_800_000_u64, "sessionId":"rmd-native-session",
+        "deviceId":"rmd-native-device", "userId":"rmd-native-account",
+    }).to_string().as_bytes());
+    let jwt = |payload: Value| format!(
+        "e30.{}.rmd-synthetic-signature",
+        URL_SAFE_NO_PAD.encode(serde_json::to_vec(&payload).unwrap()),
+    );
+    write_private(&owned.join("codex/auth.json"), json!({
+        "auth_mode":"chatgpt",
+        "tokens":{
+            "access_token":jwt(json!({"https://api.openai.com/auth":{"chatgpt_account_id":"rmd-codex-workspace"}, "exp":4_102_444_800_u64})),
+            "refresh_token":"rmd-synthetic-refresh",
+            "id_token":jwt(json!({"aud":"rmd-synthetic-client"})),
+            "account_id":"rmd-codex-workspace",
+        },
+    }).to_string().as_bytes());
+    let nonce = uuid::Uuid::new_v4().to_string();
+    write_private(&owned.join("allocation.json"), json!({
+        "case":exact, "nonce":nonce, "parentPid":std::process::id(),
+    }).to_string().as_bytes());
+    let stdout = owned.join("stdout.log");
+    let stderr = owned.join("stderr.log");
+    let mut command = Command::new(std::env::current_exe().unwrap());
+    command.args(["--exact", &exact, "--nocapture", "--test-threads=1"]).env_clear();
+    for key in ["PATH", "SYSTEMROOT", "WINDIR", "LD_LIBRARY_PATH", "DYLD_LIBRARY_PATH", "DYLD_FALLBACK_LIBRARY_PATH"] {
+        if let Some(value) = std::env::var_os(key) { command.env(key, value); }
+    }
+    command.env(CHILD_CASE, &exact).env(CHILD_ROOT, &owned).env(CHILD_NONCE, &nonce)
+        .env("CODEX_HOME", owned.join("codex"))
+        .env(FABUSHI_HOST_ACCESS_CREDENTIAL_FILE_ENV, owned.join("native-credential.json"))
+        .env("FABUSHI_RESPONSES_URL", format!("{origin}/v1/responses"))
+        .env("FABUSHI_RESPONSES_MODEL", "rmd-environment-model-must-not-win")
+        .env("NO_PROXY", "127.0.0.1,localhost").env("no_proxy", "127.0.0.1,localhost")
+        .env("TMPDIR", owned.join("tmp")).env("TEMP", owned.join("tmp")).env("TMP", owned.join("tmp"))
+        .stdout(Stdio::from(fs::File::create(&stdout).unwrap()))
+        .stderr(Stdio::from(fs::File::create(&stderr).unwrap()));
+    for key in ["HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "http_proxy", "https_proxy", "all_proxy"] {
+        command.env(key, &origin);
+    }
+    if product_mode { command.env("FABUSHI_PRODUCT_MODE", "1"); }
+    let mut child = OwnedChild {
+        child: command.spawn().expect("start the exact owned App test"),
+        terminal: false, kill_requested: false,
+    };
+    drop(command);
+    let pid = child.child.id();
+    let exit = child.wait();
+    let transport = network.finish();
+    assert!(
+        matches!(&exit, Ok(status) if status.success()) && transport.is_ok() && child.terminal,
+        "RMD child/transport failed; exit={exit:?}; transport={transport:?}; retained={}\nstdout:\n{}\nstderr:\n{}",
+        owned.display(), fs::read_to_string(&stdout).unwrap_or_default(),
+        fs::read_to_string(&stderr).unwrap_or_default(),
+    );
+    let receipt: Value = serde_json::from_slice(&fs::read(owned.join("completed.json"))
+        .expect("selected child must finish its actual assertions")).unwrap();
+    assert_eq!(receipt, json!({
+        "case":exact, "nonce":nonce, "pid":pid, "phase":"assertions-returned",
+    }));
+    assert!(fs::read_to_string(&stdout).unwrap().contains("test result: ok. 1 passed"),
+        "exact child selection must execute one test");
+    let requests = transport.unwrap();
+    if !provider_flow { assert!(requests.is_empty()); }
+    fs::remove_dir_all(owned).expect("cleanup after actual child and transport termination");
+    requests
+}
