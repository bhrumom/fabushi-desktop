+    fn reset_args(&self) -> Value {
+        let admission = self.admission();
+        json!({
+            "key":admission.session_key, "expectedSessionId":admission.session_id,
+            "expectedLifecycleRevision":admission.lifecycle_revision,
+            "modelSelection":{"resetToDefault":true},
+        })
+    }
