+                assert_eq!(fixture.request("sessions.patch", None, "", &forged).0, 401);
+                assert!(fixture.observe() == before);
+            }
+            assert!(fixture.api.as_ref().unwrap().paired_admissions.load(Ordering::SeqCst) >= 3);
+            let before = fixture.observe();
+            let (status, paired_status, _) = fixture.request(
