+    for raw in invalid_entries {
+        assert!(owner.write_kv(MODEL_SELECTION_KEY, &raw).unwrap());
+        let before = fixture.observe();
+        assert!(fixture.read(&fixture.agent_id, &fixture.admission.lifecycle_revision).is_err());
+        assert!(fixture.sessions.read_session_model_entry(&fixture.agent_id).is_err());
+        let error = fixture.reset(&fixture.agent_id, &fixture.admission.lifecycle_revision).unwrap_err();
+        assert!(
+            error.starts_with("invalid session model selection:")
+                || error.contains("session model selection belongs to"),
+            "strict state failure must remain visible: {error}",
+        );
+        assert_eq!(owner.read_kv(MODEL_SELECTION_KEY).unwrap().as_deref(), Some(raw.as_str()));
+        assert_eq!(fixture.observe(), before);
+    }
+    fixture.seed_selection(&fixture.selected);
+    assert!(applied(fixture.reset(&fixture.agent_id, &fixture.admission.lifecycle_revision)).changed);
+}
