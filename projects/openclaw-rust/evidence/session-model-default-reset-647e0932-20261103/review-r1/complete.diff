+test("agent settings model reset fences account controller replacement and disposal", async () => {
+  const previous = fixture();
+  await readStatus(previous, status("alpha", "account-one"));
+  let previousEmits = 0;
+  previous.controller.subscribe(() => { previousEmits += 1; });
+  const oldReset = previous.controller.resetSessionModelSelection();
+  const beforeDispose = previousEmits;
+  previous.controller.dispose();
+  previous.controller.dispose();
+  assert.equal(previous.disposedSubscriptions(), 1);
+  assert.equal(await previous.controller.resetSessionModelSelection(), false);
+  assert.equal(await previous.controller.refreshSessionModelSelection(), false);
+
+  // ProductionRenderer recreates this owner for its new account identity.
+  const replacement = fixture();
+  await readStatus(replacement, status("alpha", "account-two", {
+    override: { provider: "codex", modelId: "Account-Two-A" },
+    default: { provider: "codex", modelId: "Account-Two-B" },
+  }));
+  const current = replacement.controller.getSnapshot();
+  previous.resets[0].result.resolve(acknowledgement("alpha", "account-one"));
+  assert.equal(await oldReset, false);
+  previous.emitAgent({ ...agent(), name: "Old account event" });
+  assert.equal(previousEmits, beforeDispose);
+  assert.strictEqual(replacement.controller.getSnapshot(), current);
+  assert.equal(replacement.resets.length, 0);
+
+  const abandoned = fixture();
+  const lateRead = abandoned.controller.refreshSessionModelSelection();
+  abandoned.controller.dispose();
+  const staleError = new Error("Disposed account read failed");
+  abandoned.reads[0].result.reject(staleError);
+  await assert.rejects(lateRead, (cause) => cause === staleError);
+  assert.strictEqual(replacement.controller.getSnapshot(), current);
+  replacement.controller.dispose();
+});
