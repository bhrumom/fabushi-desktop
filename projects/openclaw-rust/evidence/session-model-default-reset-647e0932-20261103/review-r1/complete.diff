+#[test]
+fn session_model_default_reset_archive_restore_fences_reads_and_mutations() {
+    let fixture = Fixture::new("archive-restore");
+    let archived = fixture.archive(&fixture.admission, true);
+    assert_ne!(archived.lifecycle_revision, fixture.admission.lifecycle_revision);
+    let before = fixture.observe();
+
+    assert_eq!(
+        fixture.read(&fixture.agent_id, &archived.lifecycle_revision).unwrap(),
+        fixture.selected,
+        "archived state remains observable under its current lifecycle",
+    );
+    assert_eq!(
+        fixture.read(&fixture.agent_id, &fixture.admission.lifecycle_revision).unwrap_err(),
+        "SESSION_LIFECYCLE_CHANGED",
+    );
+    assert_eq!(
+        fixture.reset(&fixture.agent_id, &archived.lifecycle_revision).unwrap_err(),
+        "SESSION_LIFECYCLE_CHANGED",
+        "a successful archived read must not admit a reset",
+    );
+    assert_eq!(
+        fixture.reset(&fixture.agent_id, &fixture.admission.lifecycle_revision).unwrap_err(),
+        "SESSION_LIFECYCLE_CHANGED",
+    );
+    assert_eq!(fixture.observe(), before);
+
+    let restored = fixture.archive(&archived, false);
+    assert_ne!(restored.lifecycle_revision, archived.lifecycle_revision);
+    assert_ne!(restored.lifecycle_revision, fixture.admission.lifecycle_revision);
+    let restored_before = fixture.observe();
+    for revision in [&fixture.admission.lifecycle_revision, &archived.lifecycle_revision] {
+        assert_eq!(fixture.reset(&fixture.agent_id, revision).unwrap_err(), "SESSION_LIFECYCLE_CHANGED");
+        assert_eq!(fixture.read(&fixture.agent_id, revision).unwrap_err(), "SESSION_LIFECYCLE_CHANGED");
+        assert_eq!(fixture.observe(), restored_before);
+    }
+    assert_eq!(
+        fixture.read(&fixture.agent_id, &restored.lifecycle_revision).unwrap(),
+        fixture.selected,
+    );
+    assert!(applied(fixture.reset(&fixture.agent_id, &restored.lifecycle_revision)).changed);
+}
