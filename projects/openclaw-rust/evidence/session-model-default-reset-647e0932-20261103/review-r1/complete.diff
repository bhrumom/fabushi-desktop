+#[test]
+fn session_model_default_reset_deleted_recreated_session_rejects_old_observation() {
+    let fixture = Fixture::new("delete-recreate");
+    let retired_owner = fixture.owner();
+    let db_path = retired_owner.db_path().to_path_buf();
+    fixture.sessions.delete_session(&fixture.agent_id).unwrap();
+    assert!(retired_owner.is_closed());
+    assert!(!db_path.exists());
+    assert!(fixture.reset(&fixture.agent_id, &fixture.admission.lifecycle_revision).is_err());
+    assert!(fixture.read(&fixture.agent_id, &fixture.admission.lifecycle_revision).is_err());
+    assert!(!db_path.exists(), "stale requests must not recreate a missing session");
+
+    // Recreate the same directory identity with the real materialization DB
+    // initializer. The production admission owner mints the new revision.
+    fs::create_dir_all(db_path.parent().unwrap()).unwrap();
+    initialize_persisted_agent_record(
+        &db_path, 0, &fixture.agent_id, "user", None, 400, &"00".repeat(32),
+    ).unwrap();
+    fixture.production.ensure_main_session_work_admission(&fixture.agent_id).unwrap();
+    let recreated = fixture.production.read_session_work_admission(
+        &fixture.agent_id,
+    ).unwrap().unwrap();
+    assert_ne!(recreated.lifecycle_revision, fixture.admission.lifecycle_revision);
+    fixture.seed_selection(&fixture.selected);
+    let current_owner = fixture.owner();
+    assert!(!Arc::ptr_eq(&retired_owner, &current_owner));
+    let before = fixture.observe();
+
+    assert!(!retired_owner.write_session_kv_if_generation(
+        MODEL_SELECTION_KEY,
+        "{}",
+        &fixture.agent_id,
+        &fixture.admission.lifecycle_revision,
+    ).unwrap());
+    assert_eq!(
+        fixture.reset(&fixture.agent_id, &fixture.admission.lifecycle_revision).unwrap_err(),
+        "SESSION_LIFECYCLE_CHANGED",
+    );
+    assert_eq!(
+        fixture.read(&fixture.agent_id, &fixture.admission.lifecycle_revision).unwrap_err(),
+        "SESSION_LIFECYCLE_CHANGED",
+    );
+    assert_eq!(fixture.observe(), before);
+    assert_eq!(
+        fixture.read(&fixture.agent_id, &recreated.lifecycle_revision).unwrap(),
+        fixture.selected,
+    );
+    assert!(applied(fixture.reset(&fixture.agent_id, &recreated.lifecycle_revision)).changed);
+}
