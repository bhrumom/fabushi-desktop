+fn session_model_owner_error(error: String) -> GatewayCommandError {
+    if error == "SESSION_LIFECYCLE_CHANGED"
+        || error == "SESSION_MODEL_SELECTION_NOT_COMMITTED_OR_STALE"
+        || error.contains("not admitted")
+    {
+        GatewayCommandError::Conflict(error)
+    } else {
+        GatewayCommandError::Internal(error)
+    }
+}
+
+fn session_model_override_projection(
+    entry: &SessionModelEntryState,
+) -> Result<serde_json::Value, GatewayCommandError> {
+    let valid = |value: &str| !value.is_empty() && value.trim() == value
+        && !value.chars().any(char::is_control);
+    match (entry.provider_override.as_deref(), entry.model_override.as_deref()) {
+        (None, None) => Ok(serde_json::Value::Null),
+        (Some(provider), Some(model)) if valid(provider) && valid(model) =>
+            Ok(serde_json::json!({"provider": provider, "modelId": model})),
+        _ => Err(GatewayCommandError::Internal(
+            "persisted session model must contain a complete valid provider/model pair".into(),
+        )),
+    }
+}
