+    fn archive(&self, archived: bool) -> SessionWorkAdmissionRecord {
+        let current = self.admission();
+        self.sessions.transition_session_work_archive(
+            &self.agent_id, &current.session_key, &current.session_id,
+            Some(&current.lifecycle_revision), archived, Some("rmd-control"),
+            Some("real lifecycle control"), 200.0,
+        ).unwrap()
+    }
+}
