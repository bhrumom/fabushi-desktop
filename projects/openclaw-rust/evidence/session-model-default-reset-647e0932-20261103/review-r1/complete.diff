+                    FABUSHI_HOST_ACCESS_CREDENTIAL_FILE_ENV.to_string(),
+                    std::env::var(FABUSHI_HOST_ACCESS_CREDENTIAL_FILE_ENV).unwrap(),
+                )]),
+                backend_url: Some("http://127.0.0.1:9".into()), backend: None,
+                machine_id: Arc::new(|| Ok("rmd-native-device".into())),
+                log: Arc::new(|_| {}), now_ms: Arc::new(|| 10_000),
+            },
+            Arc::new(|_| Ok(None)),
+        ).unwrap());
+        let inference = Arc::new(start_production_inference_extension(
+            auth,
+            Arc::new(HostExperimentsExtension::new(HostExperimentsOptions {
+                is_dev_build: false, env_gate_overrides: None,
+            })),
+            Arc::clone(&settings),
+        ));
+        let sessions = Arc::new(ProductionSessionWorkers::with_agents_root(root.join("agents"), 0));
+        let agent_id = sessions.materialize_new_session(None, "user", None).unwrap().id;
+        let selected = SessionModelEntryState {
+            session_id: agent_id.clone(),
+            provider_override: Some(provider.into()), model_override: Some(MODEL_A.into()),
+            auth_profile_override: Some(PROFILE_SENTINEL.into()),
+            thinking_level: Some("high".into()),
+            ..SessionModelEntryState::default()
+        };
+        let owners = Self { root, settings, inference, sessions, agent_id, selected };
+        owners.put_selection(&owners.selected);
+        assert!(owners.sessions.open_agent_db_owner(&owners.agent_id).unwrap()
+            .write_kv("rmdUnrelatedState", r#" {"unchanged": [1, 2, 3]} "#).unwrap());
+        owners.sessions.summarize_agent_by_id(&owners.agent_id, None).unwrap().unwrap();
+        owners
+    }
