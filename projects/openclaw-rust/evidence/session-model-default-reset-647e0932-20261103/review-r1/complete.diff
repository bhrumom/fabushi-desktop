+#[derive(Clone, Debug)]
+struct ProviderRequest {
+    target: String,
+    authorization: Option<String>,
+    chatgpt_account: bool,
+    json: Value,
+}
+
+fn read_provider_request(stream: &mut TcpStream) -> Result<ProviderRequest, String> {
+    stream.set_nonblocking(false).map_err(|error| error.to_string())?;
+    stream.set_write_timeout(Some(WAIT)).map_err(|error| error.to_string())?;
+    let deadline = Instant::now() + WAIT;
+    let mut bytes = Vec::new();
+    loop {
+        let remaining = deadline.checked_duration_since(Instant::now())
+            .filter(|remaining| !remaining.is_zero()).ok_or("bounded provider request deadline")?;
+        stream.set_read_timeout(Some(remaining)).map_err(|error| error.to_string())?;
+        let mut chunk = [0_u8; 8192];
+        let count = stream.read(&mut chunk).map_err(|error| error.to_string())?;
+        if count == 0 { return Err("provider request closed before completion".into()); }
+        bytes.extend_from_slice(&chunk[..count]);
+        if bytes.len() > 4 * 1024 * 1024 { return Err("bounded provider request size".into()); }
+        let Some(end) = bytes.windows(4).position(|part| part == b"\r\n\r\n") else { continue; };
+        let headers = std::str::from_utf8(&bytes[..end]).map_err(|error| error.to_string())?;
+        let first = headers.lines().next().ok_or("missing provider request line")?;
+        if first != "POST /v1/responses HTTP/1.1" {
+            return Err(format!("unexpected outbound request target: {first}"));
+        }
+        let mut authorization = None;
+        let mut length = None;
+        let mut chatgpt_account = false;
+        for line in headers.lines().skip(1) {
+            let (key, value) = line.split_once(':').ok_or("invalid provider header")?;
+            if key.eq_ignore_ascii_case("authorization") {
+                if authorization.replace(value.trim().to_string()).is_some() {
+                    return Err("duplicate provider authorization".into());
+                }
+            }
+            if key.eq_ignore_ascii_case("chatgpt-account-id") { chatgpt_account = true; }
+            if key.eq_ignore_ascii_case("content-length") {
+                length = Some(value.trim().parse::<usize>().map_err(|_| "invalid request length")?);
+            }
+        }
+        let length = length.ok_or("missing request length")?;
+        if length > 4 * 1024 * 1024 { return Err("bounded provider body length".into()); }
+        if bytes.len() >= end + 4 + length {
+            return Ok(ProviderRequest {
+                target: first.to_string(),
+                authorization,
+                chatgpt_account,
+                json: serde_json::from_slice(&bytes[end + 4..end + 4 + length])
+                    .map_err(|_| "invalid provider request JSON")?,
+            });
+        }
+    }
+}
+
+fn provider_response(index: usize) -> Result<String, String> {
+    let (text, output) = match index {
+        0 => ("before reset ", vec![
+            json!({"type":"reasoning", "id":"rmd-reasoning-a",
+                "encrypted_content":"rmd-opaque-reasoning-a", "summary":[]}),
+            json!({"type":"function_call", "name":"SendMessage", "call_id":"rmd-reset-send",
+                "arguments":json!({"type":"text", "content":"reset after model A admission"}).to_string()}),
+        ]),
+        1 => ("turn A continued", Vec::new()),
+        2 => ("turn B default", Vec::new()),
+        _ => return Err("unexpected extra provider request".into()),
+    };
+    Ok([
+        json!({"type":"response.output_text.delta", "delta":text}),
+        json!({"type":"response.completed", "response":{
+            "id":format!("rmd-response-{index}"), "output":output,
+            "usage":{"input_tokens":11, "output_tokens":3},
+        }}),
+    ].iter().map(|event| format!("data: {event}\n\n")).collect())
+}
+
+struct NetworkGuard {
+    address: SocketAddr,
+    stop: Arc<AtomicBool>,
+    requests: Arc<Mutex<Vec<ProviderRequest>>>,
+    completed: Receiver<Result<(), String>>,
+    thread: Option<JoinHandle<()>>,
+}
+
+impl NetworkGuard {
+    fn new(provider_flow: bool) -> Self {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = listener.local_addr().unwrap();
+        let stop = Arc::new(AtomicBool::new(false));
+        let stopped = Arc::clone(&stop);
+        let requests = Arc::new(Mutex::new(Vec::new()));
+        let observed = Arc::clone(&requests);
+        let (complete, completed) = mpsc::sync_channel(1);
+        let worker = thread::spawn(move || {
+            let result = (|| {
+                loop {
+                    let (mut stream, _) = listener.accept().map_err(|error| error.to_string())?;
+                    if stopped.load(Ordering::Acquire) { return Ok(()); }
+                    let request = read_provider_request(&mut stream)?;
+                    let index = {
+                        let mut requests = observed.lock().map_err(|_| "provider capture poisoned")?;
+                        let index = requests.len();
+                        requests.push(request.clone());
+                        index
+                    };
+                    if !provider_flow { return Err("non-provider control attempted outbound transport".into()); }
+                    let expected_authorization = format!("Bearer {PROVIDER_TOKEN}");
+                    if request.authorization.as_deref() != Some(expected_authorization.as_str())
+                        || request.chatgpt_account
+                    {
+                        return Err("request did not retain the owned Fabushi binding".into());
+                    }
+                    let body = provider_response(index)?;
+                    write!(stream,
+                        "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+                        body.len(),
+                    ).map_err(|error| error.to_string())?;
+                    stream.flush().map_err(|error| error.to_string())?;
+                }
+            })();
+            let _ = complete.send(result);
+        });
+        Self { address, stop, requests, completed, thread: Some(worker) }
+    }
+
+    fn finish(&mut self) -> Result<Vec<ProviderRequest>, String> {
+        let Some(worker) = self.thread.take() else {
+            return Ok(self.requests.lock().unwrap().clone());
+        };
+        self.stop.store(true, Ordering::Release);
+        let _ = TcpStream::connect_timeout(&self.address, Duration::from_secs(1));
+        let outcome = match self.completed.recv_timeout(WAIT + WAIT) {
+            Ok(result) => {
+                worker.join().map_err(|_| "provider fixture panicked")?;
+                result
+            }
+            Err(RecvTimeoutError::Disconnected) => {
+                let _ = worker.join();
+                Err("provider fixture exited without its terminal result".into())
+            }
+            Err(RecvTimeoutError::Timeout) => {
+                return Err("provider fixture did not acknowledge bounded shutdown".into());
+            }
+        };
+        outcome?;
+        Ok(self.requests.lock().map_err(|_| "provider capture poisoned")?.clone())
+    }
+}
+
+impl Drop for NetworkGuard {
+    fn drop(&mut self) { let _ = self.finish(); }
+}
+
+struct OwnedChild {
+    child: Child,
+    terminal: bool,
+    kill_requested: bool,
+}
+
+impl OwnedChild {
+    fn retire(&mut self) {
+        if self.terminal || self.kill_requested { return; }
+        self.kill_requested = true;
+        let _ = self.child.kill();
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while Instant::now() < deadline {
+            if let Ok(Some(_)) = self.child.try_wait() {
+                self.terminal = true;
+                return;
+            }
+            thread::park_timeout(Duration::from_millis(10));
+        }
+    }
+
+    fn wait(&mut self) -> Result<ExitStatus, String> {
+        let deadline = Instant::now() + Duration::from_secs(90);
+        loop {
+            match self.child.try_wait() {
+                Ok(Some(status)) => { self.terminal = true; return Ok(status); }
+                Ok(None) if Instant::now() < deadline => {
+                    // Poll actual process termination; listener readiness is
+                    // established synchronously by bind/start, never by a delay.
+                    thread::park_timeout(Duration::from_millis(10));
+                }
+                result => {
+                    self.retire();
+                    return Err(format!("owned child timeout/observation: {result:?}; terminal={}", self.terminal));
+                }
+            }
+        }
+    }
+}
+
+impl Drop for OwnedChild {
+    fn drop(&mut self) { self.retire(); }
+}
