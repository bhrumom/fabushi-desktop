+                (fixture.native_token(), "X-Sand-Role: viewer\r\n", &args, 403),
+                (fixture.native_token(), "X-Sand-Scope: operator.read\r\n", &args, 403),
+                (fixture.native_token(), "X-Sand-Scope: operator.admin\r\n", &args, 403),
+                (Some(writer.as_str()), "X-Sand-Role: operator\r\nX-Sand-Scope: operator.write\r\n", &forged, 403),
+                (Some(reader.as_str()), "X-Sand-Scope: operator.write\r\n", &forged, 403),
+                (Some(node.as_str()), "X-Sand-Role: operator\r\nX-Sand-Scope: operator.write\r\n", &forged, 403),
+            ] {
+                let before = fixture.observe();
+                let (status, error, _) = fixture.request("sessions.patch", bearer, headers, payload);
+                assert_eq!(status, expected);
