+#[test]
+fn session_model_default_reset_malformed_model_entry_preserves_bytes_then_allows_reset() {
+    let fixture = Fixture::new("malformed");
+    let owner = fixture.owner();
+    let mut foreign = fixture.selected.clone();
+    foreign.session_id = "another-session".into();
+    let invalid_entries = [
