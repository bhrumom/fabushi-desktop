+#[test]
+fn session_model_default_reset_sqlite_write_refusals_do_not_report_applied_and_can_recover() {
+    let fixture = Fixture::new("storage-refusal");
+    let owner = fixture.owner();
+    let control = Connection::open(owner.db_path()).unwrap();
+    control.execute_batch(
+        "CREATE TRIGGER model_reset_storage_refusal
+         BEFORE INSERT ON kv WHEN NEW.key = 'sessionModelSelection'
+         BEGIN SELECT RAISE(ABORT, 'model reset storage refusal'); END;",
+    ).unwrap();
+    let before = fixture.observe();
+    let error = fixture.reset(&fixture.agent_id, &fixture.admission.lifecycle_revision).unwrap_err();
+    assert!(error.contains("model reset storage refusal"), "{error}");
+    assert_eq!(fixture.observe(), before);
+    control.execute_batch("DROP TRIGGER model_reset_storage_refusal;").unwrap();
+
+    // A real competing SQLite writer exercises the existing false/uncommitted
+    // result from the DB owner, without replacing its write implementation.
+    control.execute_batch("BEGIN IMMEDIATE").unwrap();
+    let error = fixture.reset(&fixture.agent_id, &fixture.admission.lifecycle_revision).unwrap_err();
+    assert_eq!(error, "SESSION_MODEL_SELECTION_NOT_COMMITTED_OR_STALE");
+    control.execute_batch("ROLLBACK").unwrap();
+    assert_eq!(fixture.observe(), before);
+    assert_eq!(
+        fixture.read(&fixture.agent_id, &fixture.admission.lifecycle_revision).unwrap(),
+        fixture.selected,
+    );
+    assert!(applied(fixture.reset(&fixture.agent_id, &fixture.admission.lifecycle_revision)).changed);
+}
