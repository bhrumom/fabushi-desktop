+        .map_err(session_model_owner_error)?
+        .ok_or_else(|| GatewayCommandError::Conflict("SESSION_LIFECYCLE_CHANGED".into()))?;
+    if admission.session_id != expected_session_id
+        || admission.lifecycle_revision != expected_revision
+    {
+        return Err(GatewayCommandError::Conflict("SESSION_LIFECYCLE_CHANGED".into()));
+    }
+    let entry = session_workers.read_session_model_entry_for_lifecycle(
+        agent_id, expected_session_id, expected_revision,
+    ).map_err(session_model_owner_error)?;
+    let selected = session_model_override_projection(&entry)?;
+    let default = session_model_default(inference)?;
+    let can_reset = native_control && default.is_some() && !entry.is_locked
+        && admission.archived_at_ms.is_none() && !selected.is_null();
