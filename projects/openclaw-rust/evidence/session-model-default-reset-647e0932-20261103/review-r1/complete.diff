+fn function_scope<'a>(source: &'a str, marker: &str) -> Option<&'a str> {
+    let start = source.find(marker)?;
+    let tail = &source[start + marker.len()..];
+    let end = ["\nfn ", "\n    fn ", "\n    pub fn ", "\n    pub(crate) fn "]
+        .into_iter().filter_map(|next| tail.find(next)).min().unwrap_or(tail.len());
+    Some(&source[start..start + marker.len() + end])
+}
+
+fn compact(source: &str) -> String { source.split_whitespace().collect() }
+
+fn contains_all(scope: Option<&str>, required: &[&str]) -> bool {
+    let Some(scope) = scope else { return false; };
+    let source = compact(scope);
+    required.iter().all(|needle| source.contains(&compact(needle)))
+}
+
+fn contains_in_order(scope: Option<&str>, required: &[&str]) -> bool {
+    let Some(scope) = scope else { return false; };
+    let source = compact(scope);
+    let mut remaining = source.as_str();
+    for needle in required {
+        let needle = compact(needle);
+        let Some(start) = remaining.find(&needle) else { return false; };
+        remaining = &remaining[start + needle.len()..];
+    }
+    true
+}
+
+fn shipping_bindings(main: &str, gateway: &str, session: &str, settings: &str, inference: &str) -> bool {
+    contains_all(function_scope(main, "fn authenticate_device_token("), &[
+        "self.device_pairing.authenticate_device_token(token)",
+    ])
+    && contains_all(function_scope(main, "fn call_with_context("), &[
+        "return self.call_openclaw_sessions_get(&args, context.native_control);",
+        "return self.call_openclaw_sessions_patch(&args, context);",
+    ])
+    && contains_all(function_scope(main, "fn call_openclaw_sessions_patch("), &[
+        "if args.get(\"modelSelection\").is_some()",
+        "return call_native_session_model_reset(&self.session_workers, &self.inference, args, context,);",
+    ])
+    && contains_all(function_scope(main, "fn call_native_session_model_reset("), &[
+        "if !context.authenticated || !context.native_control",
+        "object.len() == 1",
+        "object.get(\"resetToDefault\").and_then(serde_json::Value::as_bool) == Some(true)",
+        "args.get(\"communicationPolicy\").is_some() || args.get(\"archived\").is_some()",
+        "args.get(\"expectedSessionId\").and_then(serde_json::Value::as_str).filter(",
+        "args.get(\"expectedLifecycleRevision\").and_then(serde_json::Value::as_str).filter(",
+        "reset_session_model_to_default(session_workers, inference, &route.agent_id, &canonical_key, expected_session_id, expected_revision,)",
+    ])
+    && contains_all(function_scope(main, "fn reset_session_model_to_default("), &[
+        "session_model_default(inference)?",
+        "session_workers.read_session_model_entry_for_lifecycle(agent_id, expected_session_id, expected_revision,)",
+        "session_workers.apply_session_model_selection(agent_id, expected_session_id, expected_revision,",
+        "is_default: true, reset_to_default: true",
