+                "X-Sand-Role: operator\r\nX-Sand-Scope: operator.write\r\n", &args,
+            );
+            assert_eq!(status, 200, "valid native control remains usable after refusals");
+            assert_status(&acknowledged, "fabushi", false, false);
+            assert_eq!(fixture.contexts.lock().unwrap().last().unwrap(),
+                &("sessions.patch".into(), true, true));
+        }
+    });
