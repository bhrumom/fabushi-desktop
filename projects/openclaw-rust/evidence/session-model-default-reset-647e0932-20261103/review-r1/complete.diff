+#[test]
+fn session_model_reset_shipping_owner_and_context_bindings() {
+    // Compile-time source reads complement the actual adapter/owner/transport
+    // tests. They do not establish a full UnifiedGatewayApi process boot.
+    let main = include_str!("../main.rs").split_once("\n#[cfg(test)]\nmod tests {").unwrap().0;
+    let gateway = include_str!("../../../src/gateway_server.rs");
+    let session = include_str!("../../../src/extensions/session/production.rs");
+    let settings = include_str!("../../../src/extensions/settings/settings_service.rs");
+    let inference = include_str!("../../../src/extensions/inference/production.rs");
+    assert!(shipping_bindings(main, gateway, session, settings, inference));
+    for (function, from, to) in [
+        ("fn authenticate_device_token(", "self.device_pairing.authenticate_device_token(token)", "Ok(None)"),
+        ("fn call_with_context(", "return self.call_openclaw_sessions_get(&args, context.native_control);", "return discarded_status(&args);"),
+        ("fn call_with_context(", "return self.call_openclaw_sessions_patch(&args, context);", "return discarded_reset(&args);"),
+        ("fn call_openclaw_sessions_patch(", "return call_native_session_model_reset(", "return discarded_reset("),
+        ("fn call_native_session_model_reset(", "!context.authenticated || !context.native_control", "!context.authenticated"),
+        ("fn call_native_session_model_reset(", "object.len() == 1", "true"),
+        ("fn reset_session_model_to_default(", "session_workers.apply_session_model_selection(", "discarded_owner("),
+        ("fn call_openclaw_sessions_get(", "&admission.session_id, &admission.lifecycle_revision, native_control,", "&summary.id, &summary.lifecycle_revision, native_control,"),
+        ("fn call_openclaw_sessions_get(", ".map(|(admission, _)| admission.lifecycle_revision.clone())", ".map(|_| summary.as_ref().unwrap().lifecycle_revision.clone())"),
+        ("fn session_model_default(", "inference.resolve_session_model_default()", "discarded_default()"),
+        ("fn prepare_routed_turn_model_admission_with_guard(", ".read_session_model_entry(agent_id)", ".read_unrelated_entry(agent_id)"),
+        ("fn start_routed_provider_task(", "fabushi_model: fabushi_model.clone()", "fabushi_model: None"),
+        ("fn start_routed_provider_task(", "codex_model: codex_model.clone()", "codex_model: None"),
+    ] {
+        let changed = replace_in_function(main, function, from, to);
+        assert!(!shipping_bindings(&changed, gateway, session, settings, inference));
+    }
+    for (from, to) in [
+        ("device_authorization.is_none()", "true"),
+        ("authenticated && native_mcp_control", "authenticated"),
+        ("deps.api.call_with_context(method, args, &command_context)", "deps.api.call(method, args)"),
+    ] {
+        let changed = replace_in_function(gateway, "fn handle_connection(", from, to);
+        assert!(!shipping_bindings(main, &changed, session, settings, inference));
+    }
+    for (function, from, to) in [
+        ("pub fn apply_session_model_selection(", "admission.lifecycle_revision != expected_lifecycle_revision", "false"),
+        ("pub fn apply_session_model_selection(", "expected_lifecycle_revision,\n                    &state,", "&admission.lifecycle_revision,\n                    &state,"),
+        ("pub fn read_session_model_entry_for_lifecycle(", "admission.session_id != expected_session_id", "false"),
+    ] {
+        let changed = replace_in_function(session, function, from, to);
+        assert!(!shipping_bindings(main, gateway, &changed, settings, inference));
+    }
+    let unchecked = replace_in_function(
+        settings, "pub fn get_inference_model_configuration_checked(",
+        "self.load_checked()", "self.load_unchecked()",
+    );
+    assert!(!shipping_bindings(main, gateway, session, &unchecked, inference));
+    for (from, to) in [
+        (".get_inference_model_configuration_checked()", ".get_unchecked_configuration()"),
+        ("resolve_production_inference_provider(", "discarded_route("),
+        ("resolve_provider_default_from_checked_settings(provider, stored.as_ref())", "discarded_default()"),
+    ] {
+        let changed = replace_in_function(inference, "pub fn resolve_session_model_default(", from, to);
+        assert!(!shipping_bindings(main, gateway, session, settings, &changed));
+    }
+}
