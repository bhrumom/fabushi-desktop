+                &json!({"key":fixture.owners.admission().session_key, "nativeControl":true}),
+            );
+            assert_eq!(status, 200);
+            assert_status(&paired_status, "fabushi", true, false);
+            assert_eq!(fixture.contexts.lock().unwrap().last().unwrap(),
+                &("sessions.get".into(), true, false));
+            assert!(fixture.observe() == before);
+            let (status, readonly_status, _) = fixture.request(
+                "sessions.get", fixture.native_token(), "X-Sand-Scope: operator.read\r\n",
+                &json!({"key":fixture.owners.admission().session_key}),
