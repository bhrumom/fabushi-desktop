+  const staleError = new Error("Old session reset refused");
+  f.resets[1].result.reject(staleError);
+  await assert.rejects(oldFailure, (cause) => cause === staleError);
+  assert.strictEqual(f.controller.getSnapshot(), delta);
+  assert.equal(f.controller.getSnapshot().modelSelectionError, null);
+
