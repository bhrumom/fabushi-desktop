+struct HttpFixture {
+    owners: Owners,
+    configured: bool,
+    server: Option<GatewayServer>,
+    api: Option<Arc<ResetApi>>,
+    closed: Option<Receiver<()>>,
+    contexts: Arc<Mutex<Vec<(String, bool, bool)>>>,
+}
+
+impl HttpFixture {
+    fn new(provider: &str, configured: bool) -> Self {
+        let owners = Owners::new(provider);
+        let mut fixture = Self {
+            owners, configured, server: None, api: None, closed: None,
+            contexts: Arc::new(Mutex::new(Vec::new())),
+        };
+        fixture.open();
+        for (device, role, scopes) in [
+            ("rmd-writer", "operator", vec!["operator.write"]),
+            ("rmd-reader", "operator", vec!["operator.read"]),
+            ("rmd-node", "node", vec!["node.invoke"]),
+        ] {
+            let requested = fixture.pairing().handle_pair_request(&json!({
+                "deviceId":device, "publicKey":format!("{device}-public-key"),
+                "role":role, "scopes":scopes,
+            })).unwrap();
+            fixture.pairing().handle_pair_approve(&json!({"requestId":requested["requestId"]})).unwrap();
+        }
+        fixture
+    }
+
+    fn pairing_path(&self) -> PathBuf { self.owners.root.join("pairing.db") }
+    fn pairing(&self) -> &DevicePairingOwner { self.api.as_ref().unwrap().pairing.as_ref().unwrap() }
+
+    fn open(&mut self) {
+        let (closed, receiver) = mpsc::sync_channel(1);
+        let api = Arc::new(ResetApi {
+            pairing: Some(DevicePairingOwner::new(self.pairing_path()).unwrap()),
+            sessions: Arc::clone(&self.owners.sessions), inference: Arc::clone(&self.owners.inference),
+            contexts: Arc::clone(&self.contexts), paired_admissions: AtomicUsize::new(0), closed,
+        });
+        self.server = Some(start_gateway_server(GatewayServerDeps {
+            api: api.clone(), events: GatewayEventHub::default(), local_exec: None, webauthn: None,
+            config: GatewayServerConfig { host:"127.0.0.1".into(), port:None,
+                auth_token:self.configured.then(|| NATIVE_TOKEN.into()), tls:None },
+            started_at:1,
+        }).unwrap());
+        self.api = Some(api);
+        self.closed = Some(receiver);
+    }
+
+    fn stop(&mut self) -> bool {
+        if let Some(server) = self.server.take() { server.close(); }
+        drop(self.api.take());
+        self.closed.take().is_none_or(|receiver| receiver.recv_timeout(WAIT).is_ok())
+    }
+
+    fn address(&self) -> SocketAddr {
+        SocketAddr::from(([127, 0, 0, 1], self.server.as_ref().unwrap().port()))
+    }
+
+    fn native_token(&self) -> Option<&'static str> { self.configured.then_some(NATIVE_TOKEN) }
+
+    fn request(&self, method: &str, bearer: Option<&str>, headers: &str, args: &Value) -> (u16, Value, String) {
+        let response = post(self.address(), method, bearer, headers, args);
+        for secret in [NATIVE_TOKEN, PROVIDER_TOKEN, PROFILE_SENTINEL] {
+            assert!(!response.2.contains(secret), "response exposed private authority or profile state");
+        }
+        if let Some(token) = bearer { assert!(!response.2.contains(token)); }
+        response
+    }
+
+    fn get(&self) -> (u16, Value, String) {
+        self.request("sessions.get", self.native_token(), "", &json!({"key":self.owners.admission().session_key}))
+    }
+
+    fn reset(&self, args: &Value) -> (u16, Value, String) {
+        self.request("sessions.patch", self.native_token(), "", args)
+    }
+
+    fn token(&self, device: &str, role: &str) -> String {
+        let db = Connection::open_with_flags(self.pairing_path(), OpenFlags::SQLITE_OPEN_READ_ONLY).unwrap();
+        let raw: String = db.query_row(
+            "SELECT tokens_json FROM device_pairing_paired WHERE device_id = ?1",
+            [device], |row| row.get(0),
+        ).unwrap();
+        serde_json::from_str::<Value>(&raw).unwrap()[role]["token"].as_str().unwrap().to_string()
+    }
+
+    fn observe(&self) -> OwnerObservation {
+        let path = self.owners.sessions.session_db_path(&self.owners.agent_id).unwrap();
+        let db = Connection::open_with_flags(&path, OpenFlags::SQLITE_OPEN_READ_ONLY).unwrap();
+        let mut statement = db.prepare("SELECT key, value FROM kv ORDER BY key").unwrap();
+        let kv = statement.query_map([], |row| Ok((row.get(0)?, row.get(1)?)))
+            .unwrap().collect::<rusqlite::Result<Vec<(String, String)>>>().unwrap();
+        let pairing = Connection::open_with_flags(self.pairing_path(), OpenFlags::SQLITE_OPEN_READ_ONLY).unwrap();
+        let mut rows = sql_rows(&pairing, "SELECT * FROM device_pairing_paired ORDER BY device_id");
+        rows.extend(sql_rows(&pairing, "SELECT * FROM device_pairing_pending ORDER BY request_id"));
+        rows.extend(sql_rows(&pairing, "SELECT * FROM config_machine_state ORDER BY state_key"));
+        let agent_settings = get_sand_settings_path(self.owners.root.join("agents").join(&self.owners.agent_id));
+        OwnerObservation {
+            kv, write_generation:get_sand_agent_db_write_generation(&path),
+            settings:fs::read(self.owners.settings.get_settings_path()).unwrap(),
+            agent_settings:agent_settings.is_file().then(|| fs::read(agent_settings).unwrap()),
+            pairing:rows,
+        }
+    }
+
+    fn refused(&self, args: &Value, expected_status: u16) {
+        let before = self.observe();
+        let (status, value, _) = self.reset(args);
+        assert_eq!(status, expected_status);
+        assert!(value["error"].as_str().is_some_and(|value| !value.is_empty()));
+        assert!(self.observe() == before, "refused HTTP reset mutated an existing owner");
+    }
+}
