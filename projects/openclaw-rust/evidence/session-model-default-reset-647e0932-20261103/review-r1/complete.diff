+    fn authenticate_device_token(&self, token: &str) -> Result<Option<DeviceTokenAuthorization>, GatewayCommandError> {
+        let result = self.pairing.as_ref().unwrap().authenticate_device_token(token)?;
+        if result.is_some() { self.paired_admissions.fetch_add(1, Ordering::SeqCst); }
+        Ok(result)
+    }
+
+    fn validate_paired_device_authorization(&self, authorization: &DeviceTokenAuthorization) -> Result<(), GatewayCommandError> {
+        self.pairing.as_ref().unwrap().validate_current_device_authorization(authorization)
+    }
+
+    fn call(&self, _method: &str, _args: Value) -> Result<Value, GatewayCommandError> {
+        Err(GatewayCommandError::Internal("RMD adapter requires the actual Gateway context".into()))
+    }
+
+    fn call_with_context(
+        &self, method: &str, args: Value, context: &GatewayCommandContext,
+    ) -> Result<Value, GatewayCommandError> {
+        self.contexts.lock().unwrap().push((method.into(), context.authenticated, context.native_control));
+        match method {
+            "sessions.patch" => shipping::call_native_session_model_reset(
+                &self.sessions, &self.inference, &args, context,
+            ),
+            "sessions.get" => {
+                // Presentation envelope only: actual routing and status helpers
+                // own their checks; lifecycle comes from the Session owner.
+                let key = args.get("key").and_then(Value::as_str).unwrap_or_default();
+                let route = shipping::resolve_gateway_session_route(&args, key)?;
+                shipping::reject_agent_wide_session_route(&route, "sessions.get")?;
+                let summary = self.sessions.summarize_agent_by_id(&route.agent_id, None)
+                    .map_err(GatewayCommandError::Internal)?
+                    .ok_or_else(|| GatewayCommandError::Conflict("SESSION_LIFECYCLE_CHANGED".into()))?;
+                let admission = self.sessions.read_session_work_admission(&route.agent_id)
+                    .map_err(shipping::session_model_owner_error)?
+                    .ok_or_else(|| GatewayCommandError::Conflict("SESSION_LIFECYCLE_CHANGED".into()))?;
+                if summary.id != admission.session_id {
+                    return Err(GatewayCommandError::Conflict("SESSION_LIFECYCLE_CHANGED".into()));
+                }
+                let status = shipping::session_model_selection_status(
+                    &self.sessions, &self.inference, &route.agent_id,
+                    &admission.session_id, &admission.lifecycle_revision, context.native_control,
+                )?;
+                Ok(json!({"key":admission.session_key, "sessionId":admission.session_id,
+                    "lifecycleRevision":admission.lifecycle_revision, "modelSelection":status}))
+            }
+            _ => Err(GatewayCommandError::BadRequest("unsupported test adapter method".into())),
+        }
+    }
+}
+
+impl Drop for ResetApi {
+    fn drop(&mut self) {
+        drop(self.pairing.take());
+        let _ = self.closed.try_send(());
+    }
+}
+
+fn post(address: SocketAddr, method: &str, bearer: Option<&str>, headers: &str, args: &Value) -> (u16, Value, String) {
+    let mut stream = TcpStream::connect_timeout(&address, WAIT).unwrap();
+    stream.set_write_timeout(Some(WAIT)).unwrap();
+    let authorization = bearer.map(|token| format!("Authorization: Bearer {token}\r\n")).unwrap_or_default();
+    let body = args.to_string();
+    write!(stream,
+        "POST /api/{method} HTTP/1.1\r\nHost: 127.0.0.1\r\n{authorization}{headers}Content-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+        body.len(),
+    ).unwrap();
+    stream.flush().unwrap();
+    let deadline = Instant::now() + WAIT;
+    let mut bytes = Vec::new();
+    loop {
+        let remaining = deadline.checked_duration_since(Instant::now())
+            .filter(|remaining| !remaining.is_zero()).expect("bounded Gateway response");
+        stream.set_read_timeout(Some(remaining)).unwrap();
+        let mut chunk = [0_u8; 8192];
+        let count = stream.read(&mut chunk).unwrap();
+        if count == 0 { break; }
+        bytes.extend_from_slice(&chunk[..count]);
+        assert!(bytes.len() <= 1024 * 1024, "bounded Gateway response size");
+    }
+    let raw = String::from_utf8(bytes).unwrap();
+    let status = raw.lines().next().unwrap().split_whitespace().nth(1).unwrap().parse().unwrap();
+    let body = serde_json::from_str(raw.split_once("\r\n\r\n").unwrap().1).unwrap();
+    (status, body, raw)
+}
