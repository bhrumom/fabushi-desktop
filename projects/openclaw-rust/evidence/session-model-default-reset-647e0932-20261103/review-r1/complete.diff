+            let mut forged = args.clone();
+            forged["native_control"] = json!(true);
+            forged["nativeControl"] = json!(true);
+            forged["authenticated"] = json!(true);
+            forged["context"] = json!({"authenticated":true, "native_control":true});
+            for (bearer, headers, payload, expected) in [
+                (Some("rmd-unknown-token"), "", &forged, 401),
+                (None, "Authorization: Basic rmd-forged\r\n", &forged, 401),
