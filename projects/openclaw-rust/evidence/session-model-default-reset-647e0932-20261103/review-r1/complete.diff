+struct ResetOnDelivery {
+    address: SocketAddr,
+    args: Value,
+    sessions: Arc<ProductionSessionWorkers>,
+    agent_id: String,
+    settings_path: PathBuf,
+    settings_before: Vec<u8>,
+    deliveries: Mutex<Vec<(String, Value)>>,
+    acknowledgement: Mutex<Option<Value>>,
+}
+
+impl SendMessageSink for ResetOnDelivery {
+    fn send_message(
+        &self, message: Value, timestamp_ms: u64, tool_call_id: &str,
+    ) -> Result<Option<String>, ProviderSessionError> {
+        assert!(timestamp_ms > 0);
+        let mut deliveries = self.deliveries.lock().unwrap();
+        assert!(deliveries.is_empty(), "one actual native tool effect triggers one reset");
+        assert_eq!(tool_call_id, "rmd-reset-send");
+        let before = SandAgentSessionStore::new(Arc::clone(&self.sessions))
+            .read_session_model_entry(&self.agent_id).unwrap();
+        assert_eq!(before.model_override.as_deref(), Some(MODEL_A));
+        let (status, acknowledgement, raw) = post(
+            self.address, "sessions.patch", Some(NATIVE_TOKEN), "", &self.args,
+        );
+        assert_eq!(status, 200, "actual tool delivery reaches authenticated reset helper");
+        assert!(!raw.contains(PROFILE_SENTINEL));
+        assert_status(&acknowledgement, "fabushi", false, false);
+        let stored = SandAgentSessionStore::new(Arc::clone(&self.sessions))
+            .read_session_model_entry(&self.agent_id).unwrap();
+        assert!(stored.provider_override.is_none() && stored.model_override.is_none());
+        assert_eq!(fs::read(&self.settings_path).unwrap(), self.settings_before,
+            "HTTP reset must preserve the configured B source");
+        *self.acknowledgement.lock().unwrap() = Some(acknowledgement);
+        deliveries.push((tool_call_id.into(), message));
+        Ok(Some("rmd-native-message".into()))
+    }
+}
