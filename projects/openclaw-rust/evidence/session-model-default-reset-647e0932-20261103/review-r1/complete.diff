+    assert_eq!(
+        fixture.read(&fixture.agent_id, &fixture.admission.lifecycle_revision).unwrap(),
+        fixture.selected,
+    );
+    let outcome = applied(fixture.reset(&fixture.agent_id, &fixture.admission.lifecycle_revision));
+    assert_eq!(outcome.provider, fixture.default_provider);
+    assert_eq!(outcome.model, fixture.default_model);
+    assert_eq!(outcome.effective_model_ref, "fabushi/Configured-Default-B");
+    assert!(outcome.changed);
+    assert!(outcome.runtime_change.is_none());
+
+    let acknowledged = fixture.read(
+        &fixture.agent_id, &fixture.admission.lifecycle_revision,
+    ).unwrap();
+    assert_eq!(acknowledged.provider_override, None);
+    assert_eq!(acknowledged.model_override, None);
+    assert_eq!(acknowledged.auth_profile_override, fixture.selected.auth_profile_override);
+    assert_eq!(acknowledged.thinking_level, fixture.selected.thinking_level);
+    assert_eq!(acknowledged.is_locked, fixture.selected.is_locked);
+    assert!(acknowledged.live_model_switch_pending);
+    assert_eq!(acknowledged.updated_at, 100);
+    assert_eq!(
+        fixture.sessions.read_session_model_entry(&fixture.agent_id).unwrap(),
+        acknowledged,
+    );
+    assert_eq!(
+        fixture.production.read_session_work_admission(&fixture.agent_id).unwrap().unwrap(),
+        fixture.admission,
+    );
+    let after = fixture.observe();
+    assert_eq!(unrelated_rows(&after), unrelated_rows(&before));
+    assert_eq!(after.host_settings, before.host_settings);
+    assert_eq!(after.agent_settings, before.agent_settings);
+    assert!(after.write_generation > before.write_generation);
+    let committed_raw = owner.read_kv(MODEL_SELECTION_KEY).unwrap();
+
+    fixture.production.shutdown_with_checkpoint();
+    assert!(owner.is_closed());
+    let reopened = Arc::new(ProductionSessionWorkers::with_agents_root(
+        fixture.root.join("agents"), 0,
+    ));
+    let reopened_sessions = SandAgentSessionStore::new(Arc::clone(&reopened));
+    let reopened_owner = reopened.open_agent_db_owner(&fixture.agent_id).unwrap();
+    assert!(!Arc::ptr_eq(&owner, &reopened_owner));
+    assert_eq!(
+        reopened_sessions.read_session_model_entry_for_lifecycle(
+            &fixture.agent_id, &fixture.agent_id, &fixture.admission.lifecycle_revision,
+        ).unwrap(),
+        acknowledged,
+    );
+    assert_eq!(reopened_owner.read_kv(MODEL_SELECTION_KEY).unwrap(), committed_raw);
+    let reopened_observation = fixture.observe();
+    assert_eq!(reopened_observation.kv, after.kv);
+    assert_eq!(reopened_observation.host_settings, before.host_settings);
+    assert_eq!(reopened_observation.agent_settings, before.agent_settings);
+    reopened.shutdown();
+}
