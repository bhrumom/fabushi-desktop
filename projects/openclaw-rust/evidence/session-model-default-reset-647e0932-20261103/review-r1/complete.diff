new file mode 100644
index 0000000000000000000000000000000000000000..93eaa697c6237edd165320fc11f5c411e4d22c57
--- /dev/null
+++ b/frontend/src/recovered/features/agent-info-settings-model-reset.contract.test.ts
@@ -0,0 +1,455 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  createAgentSettingsController,
+  type AgentSettingsAgent,
+  type AgentSettingsModelIdentity,
+  type AgentSettingsModelResetRequest,
+  type AgentSettingsSource,
+} from "./agent-info/settings/model.ts";
+
+interface Deferred<T> {
+  readonly promise: Promise<T>;
+  resolve(value: T): void;
+  reject(cause: unknown): void;
+}
+
+function deferred<T>(): Deferred<T> {
+  let resolve!: (value: T) => void;
+  let reject!: (cause: unknown) => void;
+  const promise = new Promise<T>((accept, refuse) => { resolve = accept; reject = refuse; });
+  return { promise, resolve, reject };
+}
+
+function agent(id = "alpha", isGroup = false): AgentSettingsAgent {
+  return { id, name: `Agent ${id}`, title: "Title", description: "Description", isGroup, notifyOnUpdatesEnabled: false };
+}
+
+interface WireModelSelection {
+  readonly version: 1;
+  readonly supported: boolean;
+  readonly override: AgentSettingsModelIdentity | null;
+  readonly default: AgentSettingsModelIdentity | null;
+  readonly locked: boolean;
+  readonly canReset: boolean;
+}
+
+function status(
+  id = "alpha",
+  revision = "opaque/0007",
+  selection: Partial<WireModelSelection> = {},
+) {
+  return {
+    key: `agent:${id}:main`,
+    sessionId: id,
+    lifecycleRevision: revision,
+    messages: [],
+    modelSelection: {
+      version: 1,
+      supported: true,
+      override: { provider: "fabushi", modelId: "Override-A" },
+      default: { provider: "fabushi", modelId: "Configured-Default-B" },
+      locked: false,
+      canReset: true,
+      ...selection,
+    } as WireModelSelection,
+  };
+}
+
+function acknowledgement(id = "alpha", revision = "opaque/0007", selection: Partial<WireModelSelection> = {}) {
+  return { ok: true, ...status(id, revision, { override: null, canReset: false, ...selection }) };
+}
+
+function fixture(initialAgent = agent()) {
+  const reads: Array<{ args: { readonly key: string }; result: Deferred<unknown> }> = [];
+  const resets: Array<{ args: AgentSettingsModelResetRequest; result: Deferred<unknown> }> = [];
+  const profiles: Array<{ args: Parameters<AgentSettingsSource["updateAgent"]>[0]; result: Deferred<unknown> }> = [];
+  const notifications: Array<{ args: Parameters<AgentSettingsSource["setAgentNotifyOnUpdates"]>[0]; result: Deferred<unknown> }> = [];
+  let listener: Parameters<NonNullable<AgentSettingsSource["subscribe"]>>[0] | undefined;
+  let disposedSubscriptions = 0;
+  const source: AgentSettingsSource = {
+    getSessionModelSelection(args) {
+      const result = deferred<unknown>();
+      reads.push({ args, result });
+      return result.promise;
+    },
+    resetSessionModelSelection(args) {
+      const result = deferred<unknown>();
+      resets.push({ args, result });
+      return result.promise;
+    },
+    updateAgent(args) {
+      const result = deferred<unknown>();
+      profiles.push({ args, result });
+      return result.promise;
+    },
+    setAgentNotifyOnUpdates(args) {
+      const result = deferred<unknown>();
+      notifications.push({ args, result });
+      return result.promise;
+    },
+    subscribe(next) {
+      listener = next;
+      return { dispose() { disposedSubscriptions += 1; listener = undefined; } };
+    },
+  };
+  const controller = createAgentSettingsController(source, initialAgent);
+  return {
+    controller, source, reads, resets, profiles, notifications,
+    emitAgent(value: unknown) { listener?.["agent-upserted"]?.(value); },
+    disposedSubscriptions: () => disposedSubscriptions,
+  };
+}
+
+async function readStatus(current: ReturnType<typeof fixture>, response: unknown = status()) {
+  const result = current.controller.refreshSessionModelSelection();
+  current.reads.at(-1)!.result.resolve(response);
+  assert.equal(await result, true);
+}
+
+test("agent settings model reset sends exact lifecycle-bound intent and applies only acknowledged state", async () => {
+  const f = fixture();
+  assert.equal(f.controller.getSnapshot().modelSelection, null);
+  assert.equal(f.controller.getSnapshot().modelSelectionAvailable, true);
+  assert.equal(await f.controller.resetSessionModelSelection(), false);
+  const read = f.controller.refreshSessionModelSelection();
+  assert.deepEqual(f.reads[0].args, { key: "agent:alpha:main" });
+  assert.equal(f.controller.getSnapshot().modelSelectionLoading, true);
+  assert.equal(await f.controller.resetSessionModelSelection(), false);
+  const revision = " opaque/0007 ";
+  f.reads[0].result.resolve(status("alpha", revision, {
+    override: { provider: "OldProvider", modelId: "Case-Preserved-A" },
+  }));
+  assert.equal(await read, true);
+  const observed = f.controller.getSnapshot().modelSelection!;
+  assert.equal(observed.lifecycleRevision, revision);
+  assert.deepEqual(observed.override, { provider: "OldProvider", modelId: "Case-Preserved-A" });
+
+  const reset = f.controller.resetSessionModelSelection();
+  assert.deepEqual(f.resets[0].args, {
+    key: "agent:alpha:main",
+    expectedSessionId: "alpha",
+    expectedLifecycleRevision: revision,
+    modelSelection: { resetToDefault: true },
+  });
+  assert.equal(f.controller.getSnapshot().pending, "model-reset");
+  assert.strictEqual(f.controller.getSnapshot().modelSelection, observed);
+  assert.equal(await f.controller.resetSessionModelSelection(), false);
+  assert.equal(await f.controller.refreshSessionModelSelection(), false);
+  assert.equal(await f.controller.setNotifications(true), false);
+  assert.equal(await f.controller.updateProfile({ name: "Other", description: "" }), false);
+  assert.equal(f.reads.length, 1);
+  assert.equal(f.resets.length, 1);
+  assert.equal(f.notifications.length, 0);
+  assert.equal(f.profiles.length, 0);
+  f.resets[0].result.resolve(acknowledgement("alpha", revision));
+  assert.equal(await reset, true);
+  const acknowledged = f.controller.getSnapshot();
+  assert.equal(acknowledged.pending, null);
+  assert.equal(acknowledged.modelSelectionError, null);
+  assert.equal(acknowledged.modelSelection?.override, null);
+  assert.equal(acknowledged.modelSelection?.canReset, false);
+  assert.deepEqual(acknowledged.modelSelection?.default, { provider: "fabushi", modelId: "Configured-Default-B" });
+  assert.equal(await f.controller.resetSessionModelSelection(), false);
+  assert.equal(f.resets.length, 1);
+  assert.deepEqual(acknowledged.agent, agent());
+  f.controller.dispose();
+});
+
+test("agent settings model reset rejects malformed status and acknowledgements without clearing the observed override", async () => {
+  const good = status();
+  const malformedStatus: unknown[] = [
+    null,
+    { ...good, key: "agent:other:main" },
+    { ...good, sessionId: "other" },
+    { ...good, lifecycleRevision: 7 },
+    { ...good, lifecycleRevision: "" },
+    { ...good, modelSelection: undefined },
+    { ...good, modelSelection: { ...good.modelSelection, version: 2 } },
+    { ...good, modelSelection: { ...good.modelSelection, default: null } },
+    { ...good, modelSelection: { ...good.modelSelection, supported: false } },
+    { ...good, modelSelection: { ...good.modelSelection, locked: "false" } },
+    { ...good, modelSelection: { ...good.modelSelection, locked: true } },
+    { ...good, modelSelection: { ...good.modelSelection, override: null } },
+    { ...good, modelSelection: { ...good.modelSelection, override: { provider: "fabushi" } } },
+    { ...good, modelSelection: { ...good.modelSelection, override: { provider: " ", modelId: "A" } } },
+    { ...good, modelSelection: { ...good.modelSelection, default: { provider: "codex", modelId: "bad\nmodel" } } },
+    { ...good, modelSelection: { ...good.modelSelection, authProfile: "not-for-the-renderer" } },
+  ];
+  for (const malformed of malformedStatus) {
+    const f = fixture();
+    await readStatus(f);
+    const observed = f.controller.getSnapshot().modelSelection;
+    const read = f.controller.refreshSessionModelSelection();
+    f.reads[1].result.resolve(malformed);
+    await assert.rejects(read, /Invalid session model status/);
+    assert.strictEqual(f.controller.getSnapshot().modelSelection, observed);
+    assert.ok(f.controller.getSnapshot().modelSelectionError instanceof Error);
+    assert.equal(f.controller.getSnapshot().modelSelectionLoading, false);
+    assert.equal(await f.controller.resetSessionModelSelection(), false);
+    assert.equal(f.resets.length, 0);
+    f.controller.dispose();
+  }
+
+  const ack = acknowledgement();
+  const malformedAcknowledgements: unknown[] = [
+    { ...ack, ok: false },
+    { ...ack, ok: undefined },
+    { ...ack, key: "agent:other:main" },
+    { ...ack, sessionId: "other" },
+    { ...ack, lifecycleRevision: "new-session-generation" },
+    { ...ack, modelSelection: { ...ack.modelSelection, override: good.modelSelection.override } },
+    { ...ack, modelSelection: { ...ack.modelSelection, supported: false, default: null } },
+    { ...ack, modelSelection: { ...ack.modelSelection, canReset: true } },
+  ];
+  for (const malformed of malformedAcknowledgements) {
+    const f = fixture();
+    await readStatus(f);
+    const observed = f.controller.getSnapshot().modelSelection;
+    const reset = f.controller.resetSessionModelSelection();
+    f.resets[0].result.resolve(malformed);
+    await assert.rejects(reset, /Invalid session model (status response|reset acknowledgement)/);
+    assert.strictEqual(f.controller.getSnapshot().modelSelection, observed);
+    assert.ok(f.controller.getSnapshot().modelSelectionError instanceof Error);
+    assert.equal(f.controller.getSnapshot().pending, null);
+    assert.equal(await f.controller.resetSessionModelSelection(), false);
+    assert.equal(f.resets.length, 1);
+    f.controller.dispose();
+  }
+});
+
+test("agent settings model reset preserves failures and requires a status read before another mutation", async () => {
+  const f = fixture();
+  const initialRead = f.controller.refreshSessionModelSelection();
+  const readError = new Error("Persisted default could not be read.");
+  f.reads[0].result.reject(readError);
+  await assert.rejects(initialRead, (cause) => cause === readError);
+  assert.equal(f.controller.getSnapshot().modelSelection, null);
+  assert.strictEqual(f.controller.getSnapshot().modelSelectionError, readError);
+  assert.equal(await f.controller.resetSessionModelSelection(), false);
+  await readStatus(f);
+
+  const observed = f.controller.getSnapshot().modelSelection;
+  const reset = f.controller.resetSessionModelSelection();
+  const writeError = new Error("Session write outcome is unknown.");
+  f.resets[0].result.reject(writeError);
+  await assert.rejects(reset, (cause) => cause === writeError);
+  assert.strictEqual(f.controller.getSnapshot().modelSelection, observed);
+  assert.strictEqual(f.controller.getSnapshot().modelSelectionError, writeError);
+  assert.equal(f.controller.getSnapshot().pending, null);
+  f.emitAgent({ ...agent(), name: "Roster update" });
+  assert.strictEqual(f.controller.getSnapshot().modelSelectionError, writeError);
+  assert.equal(await f.controller.resetSessionModelSelection(), false);
+  assert.equal(f.resets.length, 1);
+  assert.equal(f.reads.length, 2, "failed writes do not automatically cause a read or retry");
+
+  // An explicit read can discover that the write did commit. It is not replay.
+  await readStatus(f, acknowledgement());
+  assert.equal(f.controller.getSnapshot().modelSelection?.override, null);
+  assert.equal(f.controller.getSnapshot().modelSelectionError, null);
+  assert.equal(await f.controller.resetSessionModelSelection(), false);
+  assert.equal(f.resets.length, 1);
+
+  // A later explicit observation may allow a fresh user intent.
+  await readStatus(f, status("alpha", "current/revision"));
+  const laterReset = f.controller.resetSessionModelSelection();
+  assert.equal(f.resets[1].args.expectedLifecycleRevision, "current/revision");
+  f.resets[1].result.resolve(acknowledgement("alpha", "current/revision"));
+  assert.equal(await laterReset, true);
+  assert.equal(f.resets.length, 2);
+  f.controller.dispose();
+});
+
+test("agent settings model reset keeps the newest read and prevents refresh from overtaking acknowledgement", async () => {
+  const f = fixture();
+  const oldRead = f.controller.refreshSessionModelSelection();
+  const newRead = f.controller.refreshSessionModelSelection();
+  f.reads[1].result.resolve(status("alpha", "new-read"));
+  assert.equal(await newRead, true);
+  const reset = f.controller.resetSessionModelSelection();
+  assert.equal(f.resets[0].args.expectedLifecycleRevision, "new-read");
+  assert.equal(await f.controller.refreshSessionModelSelection(), false);
+  f.resets[0].result.resolve(acknowledgement("alpha", "new-read"));
+  assert.equal(await reset, true);
+  f.reads[0].result.resolve(status("alpha", "obsolete-read"));
+  assert.equal(await oldRead, false);
+  assert.equal(f.controller.getSnapshot().modelSelection?.lifecycleRevision, "new-read");
+  assert.equal(f.controller.getSnapshot().modelSelection?.override, null);
+  assert.equal(f.controller.getSnapshot().modelSelectionLoading, false);
+  assert.equal(f.controller.getSnapshot().modelSelectionError, null);
+  assert.equal(f.reads.length, 2);
+
+  const oldFailure = f.controller.refreshSessionModelSelection();
+  const latest = f.controller.refreshSessionModelSelection();
+  f.reads[3].result.resolve(status("alpha", "latest-observation"));
+  assert.equal(await latest, true);
+  const snapshot = f.controller.getSnapshot();
+  const staleError = new Error("Late rejected read");
+  f.reads[2].result.reject(staleError);
+  await assert.rejects(oldFailure, (cause) => cause === staleError);
+  assert.strictEqual(f.controller.getSnapshot(), snapshot);
+  assert.equal(f.controller.getSnapshot().modelSelectionError, null);
+  f.controller.dispose();
+});
+
+test("agent settings model reset fences agent selection changes for reads and mutation replies", async () => {
+  const f = fixture();
+  const oldRead = f.controller.refreshSessionModelSelection();
+  f.controller.setAgent(agent("beta"));
+  assert.equal(f.controller.getSnapshot().modelSelection, null);
+  const currentRead = f.controller.refreshSessionModelSelection();
+  f.reads[1].result.resolve(status("beta", "beta-revision"));
+  assert.equal(await currentRead, true);
+  const beta = f.controller.getSnapshot();
+  f.reads[0].result.resolve(status());
+  assert.equal(await oldRead, false);
+  assert.strictEqual(f.controller.getSnapshot(), beta);
+
+  const oldReset = f.controller.resetSessionModelSelection();
+  f.controller.setAgent(agent("gamma"));
+  await readStatus(f, status("gamma", "gamma-revision"));
+  const gamma = f.controller.getSnapshot();
+  f.resets[0].result.resolve(acknowledgement("beta", "beta-revision"));
+  assert.equal(await oldReset, false);
+  assert.strictEqual(f.controller.getSnapshot(), gamma);
+  assert.equal(f.controller.getSnapshot().modelSelection?.override?.modelId, "Override-A");
+
+  const oldFailure = f.controller.resetSessionModelSelection();
+  f.controller.setAgent(agent("delta"));
+  await readStatus(f, status("delta", "delta-revision"));
