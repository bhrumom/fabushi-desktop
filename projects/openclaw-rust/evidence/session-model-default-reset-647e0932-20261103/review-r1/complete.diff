+    fn put_selection(&self, value: &SessionModelEntryState) {
+        assert!(self.sessions.open_agent_db_owner(&self.agent_id).unwrap()
+            .write_kv(MODEL_KEY, &serde_json::to_string_pretty(value).unwrap()).unwrap());
+    }
