+    const child = [
+      "const fs=require('node:fs'),p=require('node:path'),root=process.argv[1];",
+      "fs.mkdirSync(p.join(root,'candidate','.headers'),{recursive:true});",
+      "fs.writeFileSync(p.join(root,'candidate','.headers','archive.tar.gz'),'owned-header');",
