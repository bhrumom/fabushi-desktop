+struct UnusedLocalMediaDelegate;
+
+impl RoutedToolBridge for UnusedLocalMediaDelegate {
+    fn list_tools(&self) -> Result<Vec<RoutedToolDefinition>, ProviderSessionError> {
+        Ok(Vec::new())
+    }
+
+    fn call_tool(
+        &self,
+        _tool: &RoutedToolDefinition,
