+            is_image: true,
+            bytes: bytes.to_vec(),
+            filename: name.into(),
+            mime: "image/png".into(),
+        }));
+    }
+    assert_eq!(fs::read(&path).expect("source retained"), bytes);
+    fs::remove_dir_all(root).expect("remove percent fixture");
+}
